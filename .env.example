# ----------------------------------------
# FLASK CONFIGURATION
# ----------------------------------------
FLASK_APP=run.py

# PRODUCTION NOTE: Must be set to 0 in production to prevent remote code execution vulnerabilities
FLASK_DEBUG=1

# PRODUCTION NOTE: Replace with a cryptographically secure random string
SECRET_KEY="replace_with_secure_secret"

# ----------------------------------------
# POSTGRESQL DOCKER INFRASTRUCTURE (DEV ONLY)
# ----------------------------------------
# PRODUCTION NOTE: If using a managed database in production, these Docker variables are ignored
POSTGRES_USER=dev_user
POSTGRES_PASSWORD=dev_secret
POSTGRES_DB=dev_db

# ----------------------------------------
# SQLALCHEMY CONNECTION STRING
# ----------------------------------------
# PRODUCTION NOTE: Update credentials and change 'localhost' to your production database host endpoint
DATABASE_URL="postgresql://dev_user:dev_secret@localhost:5432/dev_db"

# ----------------------------------------
# OPTIONAL: THIRD-PARTY INTEGRATIONS
# ----------------------------------------
MAP_THUNDERFOREST_KEY="optional_api_key_here"